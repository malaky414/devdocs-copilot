# Groq uses an OpenAI-compatible API endpoint in answer_service.py.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Qdrant connection. In Docker Compose this is overridden to http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=fastapi_docs

# Must match the model used when building the Qdrant collection.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Set to true to enable LLM-based query expansion (additional token/cost usage).
ENABLE_QUERY_EXPANSION=false
